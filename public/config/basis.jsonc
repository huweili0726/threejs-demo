{
  // 天空盒
  "skybox": "hdr/sky.hdr",
  // 需要加载的模型集合
  "modelUrls": [
    "glb/groundFloorOfficeBuilding.glb",
    "glb/underGround.glb",
    "glb/shu.glb",
    "glb/8th_floor.glb",
    "glb/9th_floor.glb"
    // "glb/空调送、回风、排烟.glb",
    // "glb/配电干线.glb",
    // "glb/消防给水.glb"
  ],
  // 人物模型URL集合
  "characterModelUrls": {
    "man": "glb/man.glb",
    "woman": "glb/woman.glb"
  },
  // 人物模型移动配置
  "characterModelMove": {
    "MAX_SPEED_MULTIPLIER": 6,
    "ACCELERATION_THRESHOLD": 500,
    "ACCELERATION_FACTOR": 0.01
  },
  // 1楼初始视角配置
  "floor_1th": {
    "perspective": { "x": -9, "y": 5, "z": -15 }, // 默认视角（大楼之外的视角）
    "directionToLook": { "x": 0, "y": 0, "z": 0 } // 默认视角（看向大楼中心）
  },
  // -1楼初始视角配置
  "floor_neg1": {
    "perspective": { "x": -2.8, "y": -1.68, "z": 3.06 }, 
    "directionToLook": { "x": 0, "y": -1.68, "z": 3.06 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": -2.6, "y": -1.78, "z": 3.06 }, // 人物模型位置（与视角同步）
    "characterModelToLook": { "x": 0, "y": -1.78, "z": 3.06 } // 人物模型看向方向（与视角同步）
  },
  // -1楼里的去2层上楼之前初始视角配置
  "before_floor_neg1_2layers": {
    "perspective": { "x": -0.82, "y": -1.68, "z": 2.7 }, 
    "directionToLook": { "x": 1, "y": -1.68, "z": 2.7 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": -0.62, "y": -1.78, "z": 2.7 }, // 人物模型位置（与视角同步）   
    "characterModelToLook": { "x": 1, "y": -1.78, "z": 2.7 } // 人物模型看向方向（与视角同步）
  },
  // -1楼里的2层初始视角配置
  "floor_neg1_2layers": {
    "perspective": { "x": -0.45, "y": -1.4, "z": 2.92 }, 
    "directionToLook": { "x": 1, "y": -1.4, "z": 2.92 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": -0.25, "y": -1.5, "z": 2.92 }, // 人物模型位置（与视角同步）    
    "characterModelToLook": { "x": 1, "y": -1.5, "z": 2.92 } // 人物模型看向方向（与视角同步）
  },
  // 8楼初始视角配置
  "floor_8th": {
    "perspective": { "x": 2, "y": 1.7, "z": 10 }, 
    "directionToLook": { "x": 2, "y": 1.7, "z": 11 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": 2, "y": 1.8, "z": 10.5 }, // 人物模型位置（与视角同步）
    "characterModelToLook": { "x": 2, "y": 1.8, "z": 11 } // 人物模型看向方向（与视角同步）
  },
  // 9楼初始视角配置
  "floor_9th": {
    "perspective": { "x": 2, "y": 1.7, "z": 10 }, 
    "directionToLook": { "x": 2, "y": 1.7, "z": 11 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": 2, "y": 1.8, "z": 10.5 }, // 人物模型位置（与视角同步）
    "characterModelToLook": { "x": 2, "y": 1.8, "z": 11 } // 人物模型看向方向（与视角同步）
  }
}