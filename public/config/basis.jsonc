/**
 * 基础配置文件
 * 
 * @description 定义项目的基础配置信息，包括天空盒、模型加载、人物模型、初始视角等
 * @structure {
 *   "skybox": "天空盒文件路径",
 *   "modelUrls": ["模型文件路径数组"],
 *   "characterModelUrls": {
 *     "man": "男性人物模型路径",
 *     "woman": "女性人物模型路径"
 *   },
 *   "characterModelMove": {
 *     "MAX_SPEED_MULTIPLIER": 最大速度倍数,
 *     "ACCELERATION_THRESHOLD": 加速度阈值,
 *     "ACCELERATION_FACTOR": 加速度因子
 *   },
 *   "楼层配置": {
 *     "perspective": { "x": 视角X, "y": 视角Y, "z": 视角Z },
 *     "directionToLook": { "x": 看向X, "y": 看向Y, "z": 看向Z },
 *     "durationTime": 切换视角动画时长(毫秒),
 *     "characterModelSetPosition": { "x": 人物X, "y": 人物Y, "z": 人物Z },
 *     "characterModelToLook": { "x": 人物看向X, "y": 人物看向Y, "z": 人物看向Z }
 *   }
 * }
 * @usage 该配置文件在应用启动时被加载到 Pinia store 中，通过 `basisStore.basisConfig` 访问
 *        系统会根据该配置文件中的信息，加载模型、设置初始视角、配置人物模型等
 */
{
  // 天空盒
  "skybox": "hdr/sky.hdr",
  // 需要加载的模型集合
  "modelUrls": [
    "glb/groundFloorOfficeBuilding.glb",
    // "glb/underGround.glb",
    "glb/shu.glb",
    "glb/8th_floor.glb",
    "glb/9th_floor.glb"
  ],
  // 人物模型URL集合
  "characterModelUrls": {
    "man": "glb/man.glb",
    "woman": "glb/woman.glb"
  },
  // 人物模型移动配置
  "characterModelMove": {
    "MAX_SPEED_MULTIPLIER": 6,
    "ACCELERATION_THRESHOLD": 500,
    "ACCELERATION_FACTOR": 0.01
  },
  // 1楼初始视角配置
  "floor_1th": {
    "perspective": { "x": -9, "y": 5, "z": -15 }, // 默认视角（大楼之外的视角）
    "directionToLook": { "x": 0, "y": 0, "z": 0 } // 默认视角（看向大楼中心）
  },
  // -1楼初始视角配置
  "floor_neg1": {
    "perspective": { "x": -2.8, "y": -1.68, "z": 3.06 }, 
    "directionToLook": { "x": 0, "y": -1.68, "z": 3.06 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": -2.6, "y": -1.78, "z": 3.06 }, // 人物模型位置（与视角同步）
    "characterModelToLook": { "x": 0, "y": -1.78, "z": 3.06 } // 人物模型看向方向（与视角同步）
  },
  // -1楼里的去2层上楼之前初始视角配置
  "before_floor_neg1_2layers": {
    "perspective": { "x": -0.82, "y": -1.68, "z": 2.7 }, 
    "directionToLook": { "x": 1, "y": -1.68, "z": 2.7 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": -0.62, "y": -1.78, "z": 2.7 }, // 人物模型位置（与视角同步）   
    "characterModelToLook": { "x": 1, "y": -1.78, "z": 2.7 } // 人物模型看向方向（与视角同步）
  },
  // -1楼里的2层初始视角配置
  "floor_neg1_2layers": {
    "perspective": { "x": -0.45, "y": -1.4, "z": 2.92 }, 
    "directionToLook": { "x": 1, "y": -1.4, "z": 2.92 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": -0.25, "y": -1.5, "z": 2.92 }, // 人物模型位置（与视角同步）    
    "characterModelToLook": { "x": 1, "y": -1.5, "z": 2.92 } // 人物模型看向方向（与视角同步）
  },
  // 8楼初始视角配置 -1.18, y: 3.20, z: -4.40
  "floor_8th": {
    "perspective": { "x": -1.18, "y": 3.05, "z": -4.40 }, 
    "directionToLook": { "x": -2, "y": 3.05, "z": -4.40 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": -1.18, "y": 3.15, "z": -4.40 }, // 人物模型位置（与视角同步）
    "characterModelToLook": { "x": -2, "y": 3.15, "z": -4.40 } // 人物模型看向方向（与视角同步）
  },
  // 9楼初始视角配置 
  "floor_9th": {
    "perspective": { "x": 0.25, "y": 3.50, "z": -3.93 }, 
    "directionToLook": { "x": 2, "y": 3.50, "z": -3.93 },
    "durationTime": 2000, // 切换视角的动画时长（毫秒）
    "characterModelSetPosition": { "x": 0.25, "y": 3.60, "z": -3.93 }, // 人物模型位置（与视角同步）
    "characterModelToLook": { "x": 2, "y": 3.60, "z": -3.93 } // 人物模型看向方向（与视角同步）
  }
}