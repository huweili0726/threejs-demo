/**
 * 碰撞检测配置文件
 * 
 * @description 定义项目中需要进行碰撞检测的物体，包括墙壁、门、楼梯等
 * @structure {
 *   "walls": [
 *     {
 *       "name": "物体模型名称",
 *       "width": 宽度 (可选),
 *       "height": 高度 (可选),
 *       "depth": 深度 (可选),
 *       "thickness": 厚度 (可选),
 *       "isStairs": 是否为楼梯 (可选)
 *     }
